# ── NestJS backend — production (Docker Compose) ─────────────────────────────
# Service hostnames match the names defined in docker-compose.yml.
# These values are also set explicitly in docker-compose so that they override
# this file if there is a mismatch — dotenv never clobbers existing env vars.

PORT=4000
CORS_ORIGIN=http://localhost:3000

DB_HOST=db
DB_PORT=5432
DB_NAME=signalscope
DB_USER=signalscope
DB_PASS=signalscope
